# Copy to .dev.vars at repo root (gitignored). Used by Wrangler and deploy-cf.sh.
# Do not commit real values.

# Cloudflare (Pages deploy: npm run deploy:cf)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Worker (npm run dev:worker) — Phase 2–3
PAGES_ORIGIN=https://altrudigitech.com
RESEND_API_KEY=
RESEND_TEST_TO=
RESEND_FROM=AltruDigiTech <hello@altrudigitech.com>
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Injected into client static forms at build (sync-lead-config.mjs)

# Slice D: studio leads (POST /api/lead, client_id studio)
STUDIO_LEAD_EMAIL=altrudigitech.studio@gmail.com

# Enable POST /api/_test/resend in local Worker only (never in production)
ALLOW_DEV_ROUTES=true